{
  // Emits the declarations of the public API types (src/api.ts) alone, for
  // buildTypes.mjs to turn into dist/witty-editor.d.ts.
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "noEmit": false,
    "declaration": true,
    "emitDeclarationOnly": true,
    // TypeScript 6 defaults rootDir to this directory; buildTypes.mjs expects
    // the declarations at dist/.types/api.d.ts, not dist/.types/src/.
    "rootDir": "src",
    "outDir": "dist/.types"
  },
  "include": [],
  "files": ["src/api.ts"]
}

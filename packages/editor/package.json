{
  "name": "@witty-works/editor",
  "version": "2.6.2",
  "description": "Witty's inclusive-language checker as an embeddable rich-text editor",
  "keywords": [
    "witty",
    "inclusive language",
    "editor",
    "tiptap",
    "writing assistant"
  ],
  "homepage": "https://github.com/witty-works/browser-extension/tree/dev/packages/editor#readme",
  "bugs": "https://github.com/witty-works/browser-extension/issues",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/witty-works/browser-extension.git",
    "directory": "packages/editor"
  },
  "license": "MIT",
  "author": "Witty Works <contact@witty.works> (https://witty.works)",
  "type": "module",
  "main": "dist/witty-editor.mjs",
  "module": "dist/witty-editor.mjs",
  "types": "dist/witty-editor.d.ts",
  "browser": "dist/witty-editor.js",
  "unpkg": "dist/witty-editor.js",
  "jsdelivr": "dist/witty-editor.js",
  "exports": {
    ".": {
      "types": "./dist/witty-editor.d.ts",
      "import": "./dist/witty-editor.mjs",
      "default": "./dist/witty-editor.mjs"
    },
    "./witty-editor.js": "./dist/witty-editor.js",
    "./witty-editor.mjs": {
      "types": "./dist/witty-editor.d.ts",
      "default": "./dist/witty-editor.mjs"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist/witty-editor.js",
    "dist/witty-editor.js.LICENSE.txt",
    "dist/witty-editor.mjs",
    "dist/witty-editor.mjs.LICENSE.txt",
    "dist/witty-editor.d.ts"
  ],
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "scripts": {
    "dev": "vite",
    "build": "vite build && npm run build:types",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "typecheck": "tsc --noEmit",
    "prepublishOnly": "npm run typecheck && npm test && npm run build",
    "build:types": "tsc -p tsconfig.api.json && node buildTypes.mjs",
    "test:types": "tsc -p types-test/tsconfig.json"
  },
  "peerDependencies": {
    "@tiptap/core": "^3.31.3"
  },
  "peerDependenciesMeta": {
    "@tiptap/core": {
      "optional": true
    }
  },
  "devDependencies": {
    "@tiptap/core": "3.31.3",
    "@tiptap/pm": "3.31.3",
    "@tiptap/starter-kit": "3.31.3",
    "@vitest/coverage-v8": "5.0.1",
    "happy-dom": "20.14.5",
    "vite": "8.3.0",
    "vite-plugin-css-injected-by-js": "5.0.2",
    "vite-plugin-svgr": "5.2.0",
    "vitest": "5.0.1"
  }
}

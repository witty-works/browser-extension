{
  "extends": "@abhijithvijayan/tsconfig",
  "compilerOptions": {
    "sourceMap": true,
    "target": "es2015", // ECMAScript target version; es2015 is the lowest TypeScript 6 supports without a deprecation.
    "module": "esnext", // Module code generation: e.g. 'commonjs', 'es2015', 'esnext', 'node16', 'nodenext' or 'preserve'.
    // Webpack bundles the extension, so imports resolve as a bundler does; the
    // base's node16 would demand file extensions on relative imports.
    "moduleResolution": "bundler",
    // The background script imports witty.config.json; the base turns it off.
    "resolveJsonModule": true,
    "lib": ["dom", "dom.iterable", "esnext"],
    "types": ["resize-observer-browser"],
    "declaration": false,
    "isolatedModules": true,
    /* Additional Checks */
    "useDefineForClassFields": true,
    "skipLibCheck": true
  },
  "include": ["source", "webpack.config.js", "__tests__/helpers/*.d.ts"],
  "exclude": ["source/lib/sentence-splitter"]
}
